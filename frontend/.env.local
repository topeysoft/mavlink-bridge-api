# YardRover Frontend - Local Development Environment

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8080/ws

# Authentication
VITE_AUTH_TOKEN_KEY=yardrover_token
VITE_AUTH_REFRESH_KEY=yardrover_refresh
VITE_SESSION_TIMEOUT=3600000

# Features
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_DEBUG_LOGGING=true

# Map Integration (placeholder keys for development)
VITE_GOOGLE_MAPS_API_KEY=development_key
VITE_DEFAULT_MAP_CENTER_LAT=40.7128
VITE_DEFAULT_MAP_CENTER_LNG=-74.0060
VITE_DEFAULT_MAP_ZOOM=15

# Weather API (placeholder for development)
VITE_WEATHER_API_KEY=development_key
VITE_WEATHER_UPDATE_INTERVAL=300000

# Application
VITE_APP_NAME=YardRover
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Autonomous Lawn Mower Control System

# Development
VITE_DEV_MOCK_API=false
VITE_DEV_API_DELAY=500
