{
  "name": "@mavlinkbridge/api-client",
  "version": "1.0.0",
  "description": "TypeScript client library for MAVLinkBridge ESP32 API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "docs": "typedoc src",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "cli": "tsx cli.ts",
    "start": "npm run cli",
    "fetch-parameters": "tsx scripts/fetch-parameter-definitions.ts",
    "update-parameters": "npm run fetch-parameters && npm run build"
  },
  "bin": {
    "mavlink-bridge": "./dist/cli.js"
  },
  "keywords": [
    "esp32",
    "api",
    "client",
    "mavlinkbridge",
    "mavlink",
    "rtcm",
    "gnss"
  ],
  "author": "MAVLinkBridge Team",
  "license": "MIT",
  "dependencies": {
    "@types/inquirer": "^9.0.9",
    "chalk": "^5.5.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "fast-json-patch": "^3.1.1",
    "inquirer": "^12.9.2",
    "ora": "^8.2.0",
    "ts-node": "^10.9.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.20.4",
    "typedoc": "^0.24.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mavlinkbridge/esp32-api"
  }
}