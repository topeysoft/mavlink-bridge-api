{
  "name": "@yardrover/console",
  "version": "1.0.0",
  "description": "Interactive console application for YardRover API management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "predev": "cd ../client && npm run build",
    "start": "npm run build && node dist/index.js",
    "console": "tsx src/index.ts",
    "debug": "node --inspect --loader tsx/esm src/index.ts",
    "predebug": "cd ../client && npm run build",
    "debug:vscode": "tsx --inspect src/index.ts",
    "debug:break": "node --inspect-brk --loader tsx/esm src/index.ts",
    "dev:verbose": "DEBUG=* tsx src/index.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "bin": {
    "yardrover-console": "dist/index.js"
  },
  "keywords": [
    "yardrover",
    "mavlinkbridge",
    "console",
    "cli",
    "interactive"
  ],
  "author": "YardRover Team",
  "license": "MIT",
  "dependencies": {
    "@mavlinkbridge/api-client": "file:../client",
    "chalk": "^5.5.0",
    "cli-table3": "^0.6.5",
    "commander": "^11.0.0",
    "inquirer": "^12.9.2",
    "ora": "^8.2.0",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.0.0"
  }
}