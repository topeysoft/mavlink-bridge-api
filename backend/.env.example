# YardRover Configuration Example
# Copy to .env and customize for your environment

# Device Settings
YARDROVER_DEVICE_NAME=YardRover Pi
YARDROVER_DEVICE_HOSTNAME=yardrover-pi

# Serial Communication
YARDROVER_SERIAL_PORT=/dev/ttyS0
YARDROVER_SERIAL_BAUDRATE=57600
YARDROVER_SERIAL_TIMEOUT=1.0

# Storage
YARDROVER_STORAGE_PATH=/var/lib/yardrover
YARDROVER_RESOURCE_STORAGE_PATH=/var/lib/yardrover/resources

# Network
YARDROVER_WIFI_AUTO_CONNECT=true
YARDROVER_AP_MODE_ENABLED=true
YARDROVER_MDNS_ENABLED=true

# RTCM/NTRIP (Optional)
YARDROVER_RTCM_ENABLED=false
YARDROVER_NTRIP_HOST=
YARDROVER_NTRIP_PORT=2101
YARDROVER_NTRIP_MOUNTPOINT=
YARDROVER_NTRIP_USERNAME=
YARDROVER_NTRIP_PASSWORD=

# Server
YARDROVER_HOST=0.0.0.0
YARDROVER_PORT=8000
YARDROVER_WORKERS=2

# Environment Mode
# Controls default settings for development vs production
# Options: development | production
# Development: debug=true, reload=true, anonymous_docs=true, log_level=DEBUG, rate_limit=false
# Production:  debug=false, reload=false, anonymous_docs=false, log_level=INFO, rate_limit=true
YARDROVER_ENVIRONMENT=production

# Logging (optional - defaults based on YARDROVER_ENVIRONMENT)
# YARDROVER_LOG_LEVEL=INFO
YARDROVER_LOG_FORMAT=json

# Development (optional - defaults based on YARDROVER_ENVIRONMENT)
# YARDROVER_DEBUG=false
# YARDROVER_RELOAD=false

# Security & Authentication
YARDROVER_SECURITY_ENABLED=true
YARDROVER_JWT_SECRET=  # Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
YARDROVER_JWT_ALGORITHM=HS256
YARDROVER_ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days
YARDROVER_API_KEY_HEADER=X-API-Key
YARDROVER_ALLOW_ANONYMOUS_HEALTH=true
# YARDROVER_ALLOW_ANONYMOUS_DOCS=false  # Defaults based on YARDROVER_ENVIRONMENT

# Rate Limiting (optional - defaults based on YARDROVER_ENVIRONMENT)
# YARDROVER_RATE_LIMIT_ENABLED=true
YARDROVER_RATE_LIMIT_REQUESTS=100
YARDROVER_RATE_LIMIT_WINDOW_SECONDS=60

# CORS (optional - defaults to ["*"])
# YARDROVER_CORS_ORIGINS=*
