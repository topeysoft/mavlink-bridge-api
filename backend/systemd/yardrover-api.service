[Unit]
Description=YardRover API Service
Documentation=https://github.com/yourusername/yardrover-api-python
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yardrover
Group=yardrover
WorkingDirectory=/opt/yardrover-api
EnvironmentFile=/etc/yardrover/yardrover-api.env

# Python virtual environment
ExecStart=/opt/yardrover-api/.venv/bin/uvicorn yardrover.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 2 \
    --log-config /etc/yardrover/logging.yaml

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yardrover-api/data /var/log/yardrover
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true

# Resource limits
MemoryMax=512M
CPUQuota=150%
TasksMax=100

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yardrover-api

[Install]
WantedBy=multi-user.target
