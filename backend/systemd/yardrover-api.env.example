# YardRover API Environment Configuration
# Copy this file to /etc/yardrover/yardrover-api.env and customize

# Application Environment
YARDROVER_ENV=production
YARDROVER_DEBUG=false
YARDROVER_LOG_LEVEL=info

# API Server Configuration
YARDROVER_HOST=0.0.0.0
YARDROVER_PORT=8000
YARDROVER_WORKERS=2

# Data Storage Paths
YARDROVER_DATA_DIR=/opt/yardrover-api/data
YARDROVER_CONFIG_FILE=/etc/yardrover/config.yaml
YARDROVER_LOG_DIR=/var/log/yardrover

# Device Information
YARDROVER_DEVICE_NAME=YardRover
YARDROVER_DEVICE_MODEL=Pi-1.0
YARDROVER_DEVICE_VERSION=1.0.0

# MAVLink Serial Configuration
YARDROVER_SERIAL_PORT=/dev/ttyAMA0
YARDROVER_SERIAL_BAUDRATE=57600
YARDROVER_SERIAL_TIMEOUT=1.0

# Network Configuration
YARDROVER_MDNS_ENABLED=true
YARDROVER_MDNS_SERVICE_NAME=yardrover
YARDROVER_MDNS_SERVICE_TYPE=_yardrover._tcp.local.

# WiFi Management (requires NetworkManager)
YARDROVER_WIFI_ENABLED=true
YARDROVER_WIFI_INTERFACE=wlan0

# WebSocket Configuration
YARDROVER_WS_HEARTBEAT_INTERVAL=30
YARDROVER_WS_MAX_CONNECTIONS=100
YARDROVER_WS_RATE_LIMIT=100
YARDROVER_WS_RATE_WINDOW=60

# RTCM/NTRIP Configuration (optional)
# YARDROVER_NTRIP_HOST=rtk2go.com
# YARDROVER_NTRIP_PORT=2101
# YARDROVER_NTRIP_MOUNTPOINT=your_mountpoint
# YARDROVER_NTRIP_USERNAME=your_email
# YARDROVER_NTRIP_PASSWORD=none

# Security (optional)
# YARDROVER_API_KEY=your_secure_api_key_here
# YARDROVER_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.100

# Health Monitoring
YARDROVER_HEALTH_CHECK_INTERVAL=60
YARDROVER_HEALTH_DISK_WARNING_MB=100
YARDROVER_HEALTH_MEMORY_WARNING_PERCENT=80

# Feature Flags
YARDROVER_ENABLE_CORS=true
YARDROVER_ENABLE_API_DOCS=true
YARDROVER_ENABLE_METRICS=true
