# YardRover Development Configuration
# This file contains development-friendly defaults
# Copy to .env or set YARDROVER_ENVIRONMENT=development

# Environment Mode - DEVELOPMENT
YARDROVER_ENVIRONMENT=development

# This automatically enables:
# - Debug mode (debug=true)
# - Hot reload (reload=true)
# - Anonymous API docs access (allow_anonymous_docs=true)
# - DEBUG log level
# - Disabled rate limiting (rate_limit_enabled=false)
# - Permissive CORS (cors_origins=["*"])

# Device Settings
YARDROVER_DEVICE_NAME=YardRover Dev
YARDROVER_DEVICE_HOSTNAME=yardrover-dev

# Serial Communication
YARDROVER_SERIAL_PORT=/dev/ttyS0
YARDROVER_SERIAL_BAUDRATE=57600

# Storage (relative paths work in dev mode)
YARDROVER_STORAGE_PATH=./dev-storage
YARDROVER_RESOURCE_STORAGE_PATH=./dev-storage/resources

# Server
YARDROVER_HOST=0.0.0.0
YARDROVER_PORT=8000

# Logging
# log_level defaults to DEBUG in development mode
YARDROVER_LOG_FORMAT=json

# Security & Authentication
YARDROVER_SECURITY_ENABLED=true
YARDROVER_JWT_SECRET=  # Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Optional: Override environment defaults
# YARDROVER_DEBUG=false  # Set to false to disable debug mode even in development
# YARDROVER_RELOAD=false  # Set to false to disable hot reload
# YARDROVER_ALLOW_ANONYMOUS_DOCS=false  # Set to false to require auth for /docs
